<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10">
        <div class="w-full text-white bg-black rounded-md py-10">
            <h1 class="px-10 pb-8">Edit You Post</h1>
            <div class="mx-10">
                <h2 class="text-zinc-400 pb-5">Your Posts</h2>
                <form action="/update/<%= post._id%>" method="POST" class="bg-transparent">
                    <textarea name="content" class="block resize-none  w-1/3 px-4 py-2 pb-10 border-2 rounded-md"><%= post.content%></textarea>
                    <button type="submit" class="block my-10 px-4 py-1 bg-blue-800 text-white rounded-md font-bold">Edit your Post</button>
                </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
