<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen flex justify-center items-center bg-zinc-900">
        <div class="w-1/3 text-white bg-black flex justify-center rounded-md">
            <form action="/register" method="post" class="px-16">
                <h1 class="text-xl font-bold pt-10 pb-5 text-center">Create an Account</h1>
                <input class=" w-full py-4 outline-none text-lg font-semibold mb-5 border-b-2 border-slate-500" type="text" placeholder="Name" name="name">
                <input class=" w-full py-4 outline-none text-lg font-semibold mb-5 border-b-2 border-slate-500" type="text" placeholder="UserName" name="username">
                <input class=" w-full py-4 outline-none text-lg font-semibold mb-5 border-b-2 border-slate-500" type="text"placeholder="Email" name="email">
                <input class=" w-full py-4 outline-none text-lg font-semibold mb-5 border-b-2 border-slate-500" type="number" name="age" placeholder="Age">
                <input class=" w-full py-4 outline-none text-lg font-semibold mb-5 border-b-2 border-slate-500" type="password" name="password" placeholder="Password">
                <div class="flex gap-3 my-4">
                    <button class=" w-1/2 px-4 py-2 outline-none text-lg font-semibold mb-5 bg-blue-800 rounded-lg text-center" type="submit">SignUp</button>
                    <!-- <a href="/register" class=" w-1/2 px-4 py-2 outline-none text-lg font-semibold mb-5 bg-red-800 rounded-lg text-center" type="submit">LogIn</a> -->
                </div>
            </form>
        </div>
    </div>
</body>
</html>