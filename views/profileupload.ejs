<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10">
        <h3 class="text-3xl text-white mb-5">Upload Image</h3>
        <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data">
            <input type="file" class="text-white" name="image">
            <input class="px-4 py-1 bg-blue-800 text-white rounded-md font-bold" type="submit" value="Submit">
        </form>
    </div>
</body>
</html>
