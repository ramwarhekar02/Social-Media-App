<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10">
        <div class="w-full text-white bg-black rounded-md py-10">
            <div class="text-xl font-bold pb-10 px-10 flex justify-between items-center">
                <h1>Profile Page</h1>
                <a href="/logout" class="px-4 py-1 bg-red-800 text-white rounded-md font-bold">Logout</a>
            </div>
            <div class="flex">
                <div>
                    <h1 class="text-2xl font-bold px-10 pt-3">Hello, <%= user.name %></h1>
                    <h5 class="pb-10 px-10">You can Create a New Post</h5>
                </div>
                <div class="w-22 h-22 rounded-full bg-red-800">
                    <img class="w-full h-full object-cover rounded-full" src="/images/uploads/<%= user.profilepic%>" alt="">
                </div>
            </div>
            <form action="/post" method="POST" class="resize-none bg-transparent mx-10">
                <textarea name="content" class="block w-1/3 px-4 py-2 pb-10 border-2 rounded-md" placeholder="What's on your Mind?" required></textarea>
                <button type="submit" class="block my-10 px-4 py-1 bg-blue-800 text-white rounded-md font-bold">Create your Post</button>
            </form>
            <div class="mx-10">
                <h2 class="text-zinc-400 pb-5">Your Posts</h2>
                <div class="flex gap-2">
                    <% user.posts.reverse().forEach(function(post) { %>
                        <div class="block w-1/3 px-4 py-2 pb-10 border-2 rounded-md mb-4">
                            <h2 class="text-blue-400 pb-5">@<%= user.username %></h2>
                            <h3 class="text-zinc-500 tracking-tight text-sm"><%= post.content %></h3>
                            <div class="flex gap-3">
                                <a href="/like/<%= post._id %>" class="text-blue-800 text-sm"> 
                                     Likes (<%= post.likes.length %>) </a>
                                <a href="/edit/<%= post._id %>" class="text-zinc-600 text-sm">Edit</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
